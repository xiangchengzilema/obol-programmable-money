# ---- Circle / Arc settlement (leave blank to run in MOCK mode) ----
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_AGENT_WALLET_ID=
ARC_USDC_TOKEN_ID=15dc2b5d-0994-58b0-bf8c-3a0501148ee8
ARC_USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
# Required for every private/live POST. Generate a long random value and send
# it as `Authorization: Bearer <token>`; never commit the real token.
OBOL_LIVE_API_TOKEN=

# ---- Agent LLM (leave blank to use the heuristic decision engine) ----
OPENAI_API_KEY=
OBOL_LLM_MODEL=gpt-4o-mini

# ---- App ----
FLASK_PORT=5001
PORT=
FLASK_DEBUG=0
OBOL_MIN_RELEVANCE=0.35
OBOL_DB_PATH=obol.db
OBOL_AUTO_SEED=1
OBOL_DISABLE_DEMO_RESET=0
